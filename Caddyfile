{
	admin off
	auto_https disable_redirects
	servers {
		# Only Cloudflare's published egress ranges may supply the client IP.
		# Direct requests ignore CF-Connecting-IP and use the socket peer instead.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
	log {
		level ERROR
	}
}

http://{$DOMAIN}, https://{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode gzip zstd
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy backend:8081 {
			header_up X-Internal-Real-IP {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Via
		}
	}

	handle /mcp {
		reverse_proxy backend:8081 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Via
		}
	}

	handle /docs* {
		reverse_proxy backend:8081 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Via
		}
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

http://*.{$INSTANCES_DOMAIN}, https://*.{$INSTANCES_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		dns_challenge_override_domain {$INSTANCES_ACME_CHALLENGE_DOMAIN}
		resolvers 1.1.1.1 1.0.0.1
	}

	reverse_proxy backend:8082 {
		header_up X-Internal-Real-IP {client_ip}
		header_up -CF-Connecting-IP
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -Via
	}
}
